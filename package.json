{
  "name": "belmondo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.smoke.mjs",
    "test:steering": "node tests/steering.browser.mjs",
    "test:audio": "node tests/audio.browser.mjs",
    "test:music": "node tests/music.browser.mjs",
    "music:stage": "node scripts/stage-soundtrack.mjs",
    "format:check": "prettier --check src tests index.html README.md docs package.json"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "prettier": "^3.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
